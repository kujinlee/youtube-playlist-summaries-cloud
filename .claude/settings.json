{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "bash .claude/hooks/block-default-branch-push.sh",
            "statusMessage": "Checking branch rule..."
          },
          {
            "type": "command",
            "if": "Bash(gh pr create*)",
            "command": "bash .claude/hooks/suggest-explainer.sh",
            "statusMessage": "Checking whether this PR wants an explainer..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-plan-gate.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-schema-gates.sh",
            "statusMessage": "Checking schema gate reminder..."
          }
        ]
      }
    ]
  }
}
