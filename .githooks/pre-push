#!/usr/bin/env bash
# git's pre-push hook (backlog #393): refuse a push whose commits add a line quoting a private plan.
# Enabled per clone by `scripts/install-git-hooks.sh` (`core.hooksPath .githooks`, shared by worktrees).
# Everything — which commits are sent, what the remote already holds, the verdict — is decided by
# `scripts/check-plan-leak.py --pre-push`, which is tested there. git aborts the push on ANY non-zero exit,
# so a crash of the checker blocks too. Escape: ALLOW_PLAN_LEAK=1 in the push's environment.
here=$(cd "$(dirname "$0")/.." && pwd)
exec python3 "$here/scripts/check-plan-leak.py" --pre-push "$@"
